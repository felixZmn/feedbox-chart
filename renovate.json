{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableDependencyDashboard"
  ],
  "labels": ["dependencies"],
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/felixzmn/docker/feedbox",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge patch image updates and bump chart patch version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/felixzmn/docker/feedbox"],
      "matchUpdateTypes": ["patch"],
      "bumpVersion": "patch",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge minor image updates and bump chart minor version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/felixzmn/docker/feedbox"],
      "matchUpdateTypes": ["minor"],
      "bumpVersion": "minor",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major image updates require a human merge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/felixzmn/docker/feedbox"],
      "matchUpdateTypes": ["major"],
      "bumpVersion": "major",
      "automerge": false
    }
  ],
  "timezone": "Europe/Berlin"
}
